{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.5": {
          "options": {
            "reasoningEffort": "xhigh"
          }
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "read":  "allow",
    "glob":  "allow",
    "grep":  "allow",
    "lsp":   "allow",
    "question": "allow",
    "todowrite": "allow",
    "bash": {
      "*":           "ask",
      "git status *": "allow",
      "git diff *":   "allow",
      "git log *":    "allow"
    },
    "edit":      "ask",
    "webfetch":  "ask",
    "websearch": "ask",
    "task":      "ask"
  }
}

