{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read":  "allow",
    "glob":  "allow",
    "grep":  "allow",
    "lsp":   "allow",
    "question": "allow",
    "todowrite": "allow",
    "bash": {
      "*":           "ask",
      "git status *": "allow",
      "git diff *":   "allow",
      "git log *":    "allow"
    },
    "edit":      "ask",
    "webfetch":  "ask",
    "websearch": "ask",
    "task":      "ask"
  }
}
