
local globals = require("hypr_globals")
-- Main modifier / paths
local home = os.getenv("HOME")

local HYPRSCRIPTS = home .. "/.config/hypr/scripts"
local SCRIPTS = home .. "/.config/ml4w/scripts"

-- Helper to keep script commands readable
local function sh(command)
	return hl.dsp.exec_cmd(command)
end

-- -----------------------------------------------------
-- Applications
-- -----------------------------------------------------

hl.bind(globals.main_mod .. " + RETURN", sh("ghostty"), { description = "Open terminal" })
hl.bind(globals.main_mod .. " + B", sh("zen-browser"), { description = "Open browser" })
hl.bind(globals.main_mod .. " + S", sh("spotify-launcher"), { description = "Open Spotify" })
hl.bind(
	globals.main_mod .. " + E",
	sh(home .. "/.config/ml4w/settings/filemanager.sh"),
	{ description = "Open file manager" }
)
hl.bind(
	globals.main_mod .. " + CTRL + C",
	sh(home .. "/.config/ml4w/settings/calculator.sh"),
	{ description = "Open calculator" }
)

-- -----------------------------------------------------
-- Windows
-- -----------------------------------------------------

hl.bind(globals.main_mod .. " + Q", hl.dsp.window.close(), { description = "Close active window" })

-- Preserves your old behaviour: kill the active window's process via PID.
hl.bind(
	globals.main_mod .. " + SHIFT + Q",
	sh("hyprctl activewindow | grep pid | tr -d 'pid:' | xargs kill"),
	{ description = "Kill active window process" }
)

hl.bind(
	globals.main_mod .. " + F",
	hl.dsp.window.fullscreen({ mode = "fullscreen", action = "toggle" }),
	{ description = "Toggle fullscreen" }
)

hl.bind(
	globals.main_mod .. " + M",
	hl.dsp.window.fullscreen({ mode = "maximized", action = "toggle" }),
	{ description = "Toggle maximized" }
)

hl.bind(globals.main_mod .. " + T", hl.dsp.window.float({ action = "toggle" }), { description = "Toggle floating" })

-- NOTE: I could not find a clean new Lua dispatcher for old `workspaceopt allfloat`.
-- This keeps your old command as a compatibility fallback. Run `hyprctl configerrors`
-- and test this one manually after reload.
hl.bind(
	globals.main_mod .. " + SHIFT + T",
	sh("hyprctl dispatch workspaceopt allfloat"),
	{ description = "Toggle all windows floating on workspace - legacy fallback" }
)

-- Dwindle split toggle, only enable if you want it.
-- WARNING: this would duplicate SUPER + S, which currently opens Spotify.
-- hl.bind(mainMod .. " + S", hl.dsp.layout("togglesplit"), { description = "Toggle split" })

hl.bind(globals.main_mod .. " + H", hl.dsp.focus({ direction = "l" }), { description = "Move focus left" })
hl.bind(globals.main_mod .. " + L", hl.dsp.focus({ direction = "r" }), { description = "Move focus right" })
hl.bind(globals.main_mod .. " + K", hl.dsp.focus({ direction = "u" }), { description = "Move focus up" })
hl.bind(globals.main_mod .. " + J", hl.dsp.focus({ direction = "d" }), { description = "Move focus down" })

hl.bind(
	globals.main_mod .. " + mouse:272",
	hl.dsp.window.drag(),
	{ mouse = true, description = "Move window with mouse" }
)
hl.bind(
	globals.main_mod .. " + mouse:273",
	hl.dsp.window.resize(),
	{ mouse = true, description = "Resize window with mouse" }
)

hl.bind(
	globals.main_mod .. " + SHIFT + L",
	hl.dsp.window.resize({ x = 100, y = 0, relative = true }),
	{ description = "Increase window width" }
)
hl.bind(
	globals.main_mod .. " + SHIFT + H",
	hl.dsp.window.resize({ x = -100, y = 0, relative = true }),
	{ description = "Reduce window width" }
)
hl.bind(
	globals.main_mod .. " + SHIFT + J",
	hl.dsp.window.resize({ x = 0, y = 100, relative = true }),
	{ description = "Increase window height" }
)
hl.bind(
	globals.main_mod .. " + SHIFT + K",
	hl.dsp.window.resize({ x = 0, y = -100, relative = true }),
	{ description = "Reduce window height" }
)

hl.bind(globals.main_mod .. " + G", hl.dsp.group.toggle(), { description = "Toggle window group" })

hl.bind(globals.main_mod .. " + ALT + H", hl.dsp.window.swap({ direction = "l" }), { description = "Swap window left" })
hl.bind(
	globals.main_mod .. " + ALT + L",
	hl.dsp.window.swap({ direction = "r" }),
	{ description = "Swap window right" }
)
hl.bind(globals.main_mod .. " + ALT + K", hl.dsp.window.swap({ direction = "u" }), { description = "Swap window up" })
hl.bind(globals.main_mod .. " + ALT + J", hl.dsp.window.swap({ direction = "d" }), { description = "Swap window down" })

-- Old file had two ALT + Tab binde lines. Lua supports multiple binds, but this is cleaner.
hl.bind("ALT + TAB", function()
	hl.dispatch(hl.dsp.window.cycle_next())
	hl.dispatch(hl.dsp.window.bring_to_top())
end, { repeating = true, description = "Cycle windows and bring active to top" })

