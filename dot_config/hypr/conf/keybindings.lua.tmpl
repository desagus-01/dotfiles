)
hl.bind(
	"XF86AudioLowerVolume",
	sh("pactl set-sink-mute @DEFAULT_SINK@ 0 && pactl set-sink-volume @DEFAULT_SINK@ -5%"),
	{ locked = true, repeating = true, description = "Decrease volume" }
)
hl.bind(
	"XF86AudioMute",
	sh("pactl set-sink-mute @DEFAULT_SINK@ toggle"),
	{ locked = true, description = "Toggle mute" }
)
hl.bind("XF86AudioPlay", sh("playerctl play-pause"), { locked = true, description = "Play/pause audio" })
hl.bind("XF86AudioPause", sh("playerctl pause"), { locked = true, description = "Pause audio" })
hl.bind("XF86AudioNext", sh("playerctl next"), { locked = true, description = "Next track" })
hl.bind("XF86AudioPrev", sh("playerctl previous"), { locked = true, description = "Previous track" })
