	globals.main_mod .. " + CTRL + L",
	sh(home .. "/.config/hypr/scripts/power.sh lock"),
	{ description = "Lock screen" }
)

-- -----------------------------------------------------
-- Workspaces
-- -----------------------------------------------------

for i = 1, 10 do
	local key = tostring(i % 10) -- workspace 10 uses key 0
	local workspace = tostring(i)

	hl.bind(
		globals.main_mod .. " + " .. key,
		hl.dsp.focus({ workspace = workspace }),
		{ description = "Open workspace " .. workspace }
	)

	-- Your comment said "Move to workspace and follow", so follow=true is intentional here.
	hl.bind(
		globals.main_mod .. " + SHIFT + " .. key,
		hl.dsp.window.move({ workspace = workspace, follow = true }),
		{ description = "Move active window to workspace " .. workspace .. " and follow" }
	)

	hl.bind(
		globals.main_mod .. " + ALT + " .. key,
		hl.dsp.window.move({ workspace = workspace, follow = false }),
		{ description = "Move active window to workspace " .. workspace .. " silently" }
	)

	hl.bind(
		globals.main_mod .. " + CTRL + " .. key,
		sh(HYPRSCRIPTS .. "/moveTo.sh " .. workspace),
		{ description = "Move all windows to workspace " .. workspace }
	)
end

hl.bind(
	globals.main_mod .. " + TAB",
	hl.dsp.focus({ workspace = "m+1" }),
	{ description = "Open next workspace on monitor" }
)
hl.bind(
	globals.main_mod .. " + SHIFT + TAB",
	hl.dsp.focus({ workspace = "m-1" }),
	{ description = "Open previous workspace on monitor" }
)

hl.bind(
	globals.main_mod .. " + mouse_down",
	hl.dsp.focus({ workspace = "e+1" }),
	{ description = "Open next existing workspace" }
)
hl.bind(
	globals.main_mod .. " + mouse_up",
	hl.dsp.focus({ workspace = "e-1" }),
	{ description = "Open previous existing workspace" }
)
hl.bind(
	globals.main_mod .. " + CTRL + down",
	hl.dsp.focus({ workspace = "empty" }),
	{ description = "Open next empty workspace" }
)

