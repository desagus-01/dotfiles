{{- if eq .chezmoi.hostname "gus-pc-cachyos-x8664" -}}
local hypr_globals = require("hypr_globals")

hl.monitor({
	output = hypr_globals.vertical_monitor_name,
	mode = "preferred",
	position = "auto-center-left",
	scale = "auto",
	transform = 3,
})

hl.monitor({
	output = hypr_globals.horizontal_monitor_name,
	mode = "preferred",
	position = "auto-right",
	scale = "auto",
})


{{- else if eq .chezmoi.hostname "laptop-cachyos-x8664" -}}
-- The internal panel is self-contained when the laptop is undocked.  The
-- DP-4 rule is only applied by Hyprland while that output exists; when it is
-- connected, place it below eDP-1.
hl.monitor({
	output = "eDP-1",
	mode = "preferred",
	position = "auto",
	-- Keep the laptop UI at its previous, less magnified scale.
	scale = 1.33,
})

hl.monitor({
	output = "DP-4",
	mode = "preferred",
	position = "auto-center-down",
	scale = "auto",
})


{{- else -}}

hl.monitor({
	output = "",
	mode = "preferred",
	position = "auto",
	scale = 1.33,
})


{{- end -}}
